<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>LTV__c</fullName>
    <formula>IF(ISBLANK(Property_Purchase_Price__c) || Property_Purchase_Price__c = 0,
      0,
Loan_Amount__c / Property_Purchase_Price__c)</formula>
